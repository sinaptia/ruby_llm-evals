source "https://rubygems.org"

gemspec path: ".."

gem "rails", "~> 8.0.0"
# Rails 8.0's JSON encoder passes quirks_mode, which JSON 3 no longer accepts.
gem "json", "< 3"

gem "puma"

gem "sqlite3"

gem "propshaft"

# Omakase Ruby styling [https://github.com/rails/rubocop-rails-omakase/]
gem "rubocop-rails-omakase", require: false

gem "dotenv"

gem "minitest", "< 6.0"
gem "vcr"
gem "webmock"

# Start debugger with binding.b [https://github.com/ruby/debug]
gem "debug", ">= 1.0.0"
